{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "festival-vote",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "festival-vote", "database_id": "a9322903-d34c-4dec-acda-902577a19542", "migrations_dir": "migrations" }],
  "observability": { "enabled": false }
}
